# ─── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API (o "Connect" en el panel de Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública: "anon" (legacy) o "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: "service_role" (legacy) o "secret" (sb_secret_...). ¡Nunca la expongas en el cliente!
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ───────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys  (solo se usa en el servidor)
OPENAI_API_KEY=sk-...
